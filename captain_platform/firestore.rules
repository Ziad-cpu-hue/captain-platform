// ─────────────────────────────────────────────────────────────────────────────
// firestore.rules  —  CapTain Platform
// Deploy with:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────
    function isAuth()            { return request.auth != null; }
    function isOwner(uid)        { return request.auth.uid == uid; }
    function getUserRole()       { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isCustomer()        { return isAuth() && getUserRole() == 'customer'; }
    function isCaptain()         { return isAuth() && getUserRole() == 'captain'; }
    function isAdmin()           { return isAuth() && getUserRole() == 'admin'; }
    function isAdminOrCaptain()  { return isAuth() && getUserRole() in ['admin', 'captain']; }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth() && (isOwner(uid) || isAdmin());
      allow create: if isAuth() && isOwner(uid);
      allow update: if isAuth() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Captain Profiles ─────────────────────────────────────────────────────
    match /captains/{uid} {
      allow read:   if isAuth();              // everyone can read (needed for order matching)
      allow write:  if isAdmin();             // only admin writes (via approval flow)
      allow update: if isAuth() && isOwner(uid) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['is_online', 'current_location', 'last_seen']);
    }

    // ── Captain Applications ─────────────────────────────────────────────────
    match /captain_applications/{uid} {
      allow read:   if isAuth() && (isOwner(uid) || isAdmin());
      allow create: if isAuth() && isOwner(uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customer: read own orders, create new ones
      allow read:   if isAuth() && (
                      resource.data.customer_id == request.auth.uid ||
                      resource.data.captain_id  == request.auth.uid ||
                      isAdmin()
                    );
      allow create: if isAuth() &&
                    request.resource.data.customer_id == request.auth.uid &&
                    request.resource.data.status == 'pending';

      // Captain: accept (set captain_id, status→accepted), update status
      allow update: if isAuth() && (
                      isAdmin() ||
                      // Captain accepting an open order
                      (isCaptain() &&
                       resource.data.status == 'pending' &&
                       request.resource.data.captain_id == request.auth.uid &&
                       request.resource.data.status == 'accepted') ||
                      // Captain updating status of their own trip
                      (isCaptain() &&
                       resource.data.captain_id == request.auth.uid &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status','completed_at','accepted_at'])) ||
                      // Customer cancelling their own pending order
                      (isAuth() &&
                       resource.data.customer_id == request.auth.uid &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'cancelled')
                    );
      allow delete: if isAdmin();
    }

    // ── Chats & Messages ─────────────────────────────────────────────────────
    match /chats/{threadId} {
      allow read:   if isAuth() && (
                      resource.data.customer_id == request.auth.uid ||
                      resource.data.captain_id  == request.auth.uid ||
                      isAdmin()
                    );
      allow create: if isAuth();
      allow update: if isAuth() && (
                      resource.data.customer_id == request.auth.uid ||
                      resource.data.captain_id  == request.auth.uid ||
                      isAdmin()
                    );

      match /messages/{msgId} {
        allow read:   if isAuth() && (
                        get(/databases/$(database)/documents/chats/$(threadId)).data.customer_id == request.auth.uid ||
                        get(/databases/$(database)/documents/chats/$(threadId)).data.captain_id  == request.auth.uid ||
                        isAdmin()
                      );
        allow create: if isAuth() &&
                      request.resource.data.sender_id == request.auth.uid;
        allow update: if isAdmin();  // admin can mark as read
        allow delete: if isAdmin();
      }
    }

    // ── Settings (admin only write, all read) ─────────────────────────────────
    match /settings/{docId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
