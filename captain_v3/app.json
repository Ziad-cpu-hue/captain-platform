{
  "expo": {
    "name": "CapTain",
    "slug": "captain-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.captain.platform",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CapTain needs your location to show your position on the map and calculate trip distance.",
        "NSLocationAlwaysUsageDescription": "CapTain needs background location to track your trip.",
        "NSCameraUsageDescription": "CapTain needs camera access to take your document photos for captain registration.",
        "NSPhotoLibraryUsageDescription": "CapTain needs photo library access to upload your documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.captain.platform",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "27c3d36f-7f89-4315-ba63-024c707ede8e"
      }
    },
    "owner": "ziad_7_fb"
  }
}
