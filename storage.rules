// ─────────────────────────────────────────────────────────────────────────────
// storage.rules  —  CapTain Platform
// Deploy with:  firebase deploy --only storage
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Captain Documents ────────────────────────────────────────────────────
    // Only the owner can upload their docs; admin & owner can read.
    match /captain_documents/{uid}/{file} {
      allow read:  if request.auth != null && (
                     request.auth.uid == uid ||
                     request.auth.token.role == 'admin'
                   );
      allow write: if request.auth != null &&
                   request.auth.uid == uid &&
                   request.resource.size < 10 * 1024 * 1024 &&   // max 10 MB
                   request.resource.contentType.matches('image/.*');
    }

    // ── Profile Pictures ─────────────────────────────────────────────────────
    match /profile_pictures/{uid}/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null &&
                   request.auth.uid == uid &&
                   request.resource.size < 5 * 1024 * 1024 &&    // max 5 MB
                   request.resource.contentType.matches('image/.*');
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
